# Copy to .streamlit/secrets.toml for local dev, or paste the same
# content into the Streamlit Cloud "Secrets" UI for deployment.

# CARTO basemap key for the Route Map (free for non-commercial use:
# carto.com/basemaps/apikey). Optional: without it the map falls back to
# Esri tiles. Must sit ABOVE the [gcp_service_account] header, or TOML
# files it under that table.
carto_api_key = "..."

# Fields below come straight from the service-account-key.json file.
[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@...iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
